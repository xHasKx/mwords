<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Activity window background visible behind transparent system
             bars in edge-to-edge mode. Adapts via values/values-night/. -->
        <item name="android:windowBackground">@color/appBackground</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Launch-phase background. Pointed at the adaptive app color
             instead of @drawable/splash so the white-bg X-logo PNG
             never paints — including when the keyboard resizes the
             activity and Android re-draws the launch theme's bg in the
             exposed area. The actual splash icon comes from the
             Android 12+ attributes below. -->
        <item name="android:background">@color/appBackground</item>
        <item name="windowSplashScreenBackground">@color/appBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- After Theme.SplashScreen dismisses, transition to the main
             theme so its windowBackground (also @color/appBackground)
             takes over for the activity's lifetime. -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>